@base     = https://serprosep.vinculasag.com/api/v1
@base_ping = https://serprosep.vinculasag.com/api/ping

@CONSULTA_API_KEY = 07966bcdd78c2ed42ac594b9656c7e5f97dcd0d1623368be


# ════════════════════════════════════════════════════════════
#  EMPLEADOS — CONSULTA (sin login, solo X-API-KEY)
# ════════════════════════════════════════════════════════════

### Un solo cuadro: coincide con RFC, CURP o NSS
GET {{base}}/empleados/consulta?q=mafe990706
X-API-KEY: {{CONSULTA_API_KEY}}

### Por RFC / CURP / NSS (una, dos o las tres; todas las enviadas deben coincidir)
GET {{base}}/empleados/consulta?rfc=MAFE990706DU3&curp=MAFE990706HMCDLR05&nss=16988040149
X-API-KEY: {{CONSULTA_API_KEY}}

### Por número de empleado (000178 o 178)
GET {{base}}/empleados/consulta?numero=000178
X-API-KEY: {{CONSULTA_API_KEY}}

### Con límite e incluyendo bajas
GET {{base}}/empleados/consulta?q=mafe990706&limit=100&bajas=1
X-API-KEY: {{CONSULTA_API_KEY}}

# ════════════════════════════════════════════════════════════
#  SERVICIOS — COORDENADAS POR ZONA (sin login, key propia CONSULTA_API_KEY)
# ════════════════════════════════════════════════════════════

### Catálogo de zonas (para saber qué id/nombre mandar)
GET {{base}}/servicios/zonas
X-API-KEY: {{CONSULTA_API_KEY}}

### Servicios y coordenadas de una zona (por id)
GET {{base}}/servicios/coordenadas?zona=3
X-API-KEY: {{CONSULTA_API_KEY}}

### Por nombre de zona, solo los que tienen coordenadas
GET {{base}}/servicios/coordenadas?zona=MEXIBUS_LINEA_3
X-API-KEY: {{CONSULTA_API_KEY}}

### Por nombre del servicio
GET {{base}}/servicios/coordenadas?q=los_patos&limit=100
X-API-KEY: {{CONSULTA_API_KEY}}



# ════════════════════════════════════════════════════════════
#  WEBHOOK — empleados nuevos / cambios (sin login, key propia WEBHOOK_EMPLEADOS_KEY)
# ════════════════════════════════════════════════════════════
@webhook_key = 5bd957f050df1c3e2eaf8e5ddc53f00a65b34b7147c3f832

### Un empleado nuevo (queda con el rostro sin enrolar)
POST {{base}}/webhooks/empleados
Content-Type: application/json
X-API-KEY: {{webhook_key}}

{
  "evento": "empleado.creado",
  "numero_empleado": "033063",
  "id_externo": "EXT-0001",
  "curp": "ABCD900101HDFXXX00",
  "paterno": "PEREZ",
  "materno": "LOPEZ",
  "nombre": "JUAN",
  "turno": "24x24"
}

### Varios a la vez
POST {{base}}/webhooks/empleados
Content-Type: application/json
X-API-KEY: {{webhook_key}}

{
  "empleados": [
    { "numero_empleado": "033064", "id_externo": "EXT-0002", "curp": "ABCD900101HDFXXX01", "paterno": "GOMEZ", "materno": "RUIZ", "nombre": "ANA", "turno": "12 X 12" },
    { "numero_empleado": "033065", "id_externo": "EXT-0003", "curp": "ABCD900101HDFXXX02", "paterno": "MARTINEZ", "materno": "", "nombre": "LUIS", "turno": "24 X 24" }
  ]
}

### ¿Ya tiene rostro enrolado? (por CURP, número o id_externo; se pueden mandar varios separados por coma)
GET {{base}}/webhooks/empleados/estado?curp=MAFE990706HMCDLR05
X-API-KEY: {{webhook_key}}

###
GET {{base}}/webhooks/empleados/estado?numero=000178,000177
X-API-KEY: {{webhook_key}}

### La otra plataforma confirma "ya lo tengo" (SIAG solo marca la fecha; no borra nada)
POST {{base}}/webhooks/empleados/confirmar
Content-Type: application/json
X-API-KEY: {{webhook_key}}

{
  "empleados": [
    { "numero_empleado": "033063", "curp": "ABCD900101HDFXXX00" }
  ]
}
